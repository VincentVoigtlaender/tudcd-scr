%
% \subsection{Die Titelseite}
%
% \begin{codedescribe}[macro,new=0.8.0]{\maketitle}
% \begin{codesyntax}
% \tsmacro{\maketitle}[Seitenzahl]
% \end{codesyntax}
% Setzt die Titelseite mit Logo, Organisationseinheiten, Art der Arbeit, Titel, Autoren, akademischem Grad,
% den betreuenden Personen sowie den Daten der Einreichung und Verteidigung.
% Anschließend folgen, sofern angegeben, die Titelrückseite (\dmacro{\uppertitleback}, \dmacro{\lowertitleback})
% und die Widmung (\dmacro{\dedication}).
% \end{codedescribe}
%
% Eine Zeile mit Angaben wird nur ausgegeben, wenn der Inhalt nicht leer ist.
%    \begin{macrocode}
%<*body&peri>
\dim_new:N \l_@@_thesis_title_logo_dim
\dim_set:Nn \l_@@_thesis_title_logo_dim { 15mm }
\cs_new_protected:Npn \@@_thesis_title_line:N #1
  { \tl_if_empty:NF #1 { #1 \par } }
\cs_new_protected:Npn \@@_thesis_title_line:nN #1#2
  { \tl_if_empty:NF #2 { #1 : ~ #2 \par } }
%    \end{macrocode}
%
% Der Block eines Autors besteht aus dem Namen und den zugehörigen Angaben.
%    \begin{macrocode}
\tl_new:N \l_@@_thesis_title_a_tl
\tl_new:N \l_@@_thesis_title_b_tl
\cs_new_protected:Npn \@@_thesis_title_author:nn #1#2
  {
    { \usekomafont{author} #2 \par }
    \smallskip 
    \group_begin:
      \usekomafont{titleinfo}
      \@@_thesis_author_get:nnN {#1} { emailaddress } \l_@@_thesis_title_a_tl
      \tl_if_empty:NF \l_@@_thesis_title_a_tl
        {
          \prop_if_in:cnTF { g_@@_thesis_author_ #1 _prop } { emailaddressnolink }
            { \bool_set_true:N \l_tmpa_bool }
            { \bool_set_eq:NN \l_tmpa_bool \g_@@_thesis_emailaddress_nolink_bool }
          \bool_lazy_or:nnTF { \l_tmpa_bool } { ! \cs_if_exist_p:N \href }
            { \l_@@_thesis_title_a_tl \par }
            {
              \exp_args:Ne \href { mailto: \l_@@_thesis_title_a_tl }
                { \l_@@_thesis_title_a_tl } \par
            }
        }
      \@@_thesis_author_get:nnN {#1} { authormore } \l_@@_thesis_title_a_tl
      \@@_thesis_title_line:N \l_@@_thesis_title_a_tl
      \@@_thesis_author_get:nnN {#1} { course } \l_@@_thesis_title_a_tl
      \@@_thesis_title_line:nN { \coursename } \l_@@_thesis_title_a_tl
      \@@_thesis_author_get:nnN {#1} { discipline } \l_@@_thesis_title_a_tl
      \@@_thesis_title_line:nN { \disciplinename } \l_@@_thesis_title_a_tl
      \@@_thesis_author_get:nnN {#1} { dateofbirth } \l_@@_thesis_title_a_tl
      \@@_thesis_author_get:nnN {#1} { placeofbirth } \l_@@_thesis_title_b_tl
      \tl_if_empty:NF \l_@@_thesis_title_a_tl
        {
          \dateofbirthtext \c_space_tl \l_@@_thesis_title_a_tl
          \tl_if_empty:NF \l_@@_thesis_title_b_tl
            { \c_space_tl \placeofbirthtext \c_space_tl \l_@@_thesis_title_b_tl }
          \par
        }
      \@@_thesis_author_get:nnN {#1} { matriculationnumber } \l_@@_thesis_title_a_tl
      \@@_thesis_title_line:nN { \matriculationnumbername } \l_@@_thesis_title_a_tl
      \@@_thesis_author_get:nnN {#1} { matriculationyear } \l_@@_thesis_title_a_tl
      \@@_thesis_title_line:nN { \matriculationyearname } \l_@@_thesis_title_a_tl
    \group_end:
  }
\cs_new_protected:Npn \@@_thesis_title_authors:
  {
    \seq_if_empty:NTF \g_@@_thesis_author_seq
      { { \usekomafont{author} \@author \par } }
      {
        \seq_map_indexed_inline:Nn \g_@@_thesis_author_seq
          {
            \int_compare:nNnF {##1} = { 1 } { \medskip }
            \@@_thesis_title_author:nn {##1} {##2}
          }
      }
  }
%    \end{macrocode}
%
% Die betreuenden Personen werden in einer Tabelle ausgegeben.
% Enthält eine Liste mehrere Personen und ist die Bezeichnung für die weiteren Personen (bspw.\@ \dmacro{\refereeothername})
% nicht leer, so erhält jede weitere Person eine eigene Bezeichnung, ansonsten wird die Mehrzahl verwendet.
%    \begin{macrocode}
\tl_new:N \l_@@_thesis_title_rows_tl
\cs_generate_variant:Nn \seq_set_split:Nnn { Nnv }
\cs_new_protected:Npn \@@_thesis_title_row:nn #1#2
  {
    \tl_put_right:Nn \l_@@_thesis_title_rows_tl
      { \tl_if_blank:nF {#1} { #1 : } & #2 \\ }
  }
\cs_new_protected:Npn \@@_thesis_title_names:n #1
  {
    \tl_if_empty:cF { @#1 }
      {
        \seq_set_split:Nnv \l_@@_thesis_tmp_seq { \and } { @#1 }
        \bool_lazy_and:nnTF
          { \int_compare_p:nNn { \seq_count:N \l_@@_thesis_tmp_seq } > { 1 } }
          { ! \tl_if_empty_p:c { #1othername } }
          {
            \seq_map_indexed_inline:Nn \l_@@_thesis_tmp_seq
              {
                \int_compare:nNnTF {##1} = { 1 }
                  { \@@_thesis_title_row:nn { \use:c { #1name } } {##2} }
                  { \@@_thesis_title_row:nn { \use:c { #1othername } } {##2} }
              }
          }
          {
            \seq_map_indexed_inline:Nn \l_@@_thesis_tmp_seq
              {
                \int_compare:nNnTF {##1} = { 1 }
                  { \@@_thesis_title_row:nn { \use:c { #1name } } {##2} }
                  { \@@_thesis_title_row:nn { } {##2} }
              }
          }
      }
  }
%    \end{macrocode}
%
% Der eigentliche Satz der Titelseite.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_thesis_title_page:
  {
    \group_begin:
    \normalfont \normalsize
    \setparsizes { 0pt } { 0pt } { 0pt plus 1fil }
    \raggedright
    \noindent \TypesetTUDLogo { \l_@@_thesis_title_logo_dim } \par
    \vspace { 2 \baselineskip }
    \group_begin:
      \usekomafont{titleinfo}
      \@@_thesis_title_line:N \@faculty
      \@@_thesis_title_line:N \@department
      \@@_thesis_title_line:N \@institute
      \@@_thesis_title_line:N \@chair
    \group_end:
    \vspace { 0pt plus 1fill }
    \tl_if_empty:NF \@titlehead { { \usekomafont{titlehead} \@titlehead \par } \bigskip }
    \bool_lazy_or:nnF
      { \tl_if_empty_p:N \@subject }
      { \tl_if_eq_p:NN \@subject \@thesis }
      { { \usekomafont{subject} \@subject \par } \medskip }
    \tl_if_empty:NF \@thesis { { \usekomafont{thesis} \@thesis \par } \bigskip }
    { \usekomafont{title} \@title \par }
    \tl_if_empty:NF \@subtitle { \medskip { \usekomafont{subtitle} \@subtitle \par } }
    \vspace { 3 \baselineskip }
    \@@_thesis_title_authors:
    \vspace { 0pt plus 1fill }
    \tl_if_empty:NF \@graduation
      {
        { \usekomafont{titleinfo} \graduationtext \par }
        \smallskip
        {
          \usekomafont{thesis} \@graduation
          \tl_if_empty:NF \@graduationabbreviation { \nobreakspace ( \@graduationabbreviation ) }
          \par
        }
        \vspace { 0pt plus 1fill }
      }
    \tl_clear:N \l_@@_thesis_title_rows_tl
    \@@_thesis_title_names:n { referee }
    \@@_thesis_title_names:n { advisor }
    \@@_thesis_title_names:n { supervisor }
    \@@_thesis_title_names:n { professor }
    \tl_if_empty:NF \@thesis
      {
        \tl_if_empty:NF \@date
          { \@@_thesis_title_row:nn { \datetext } { \usekomafont{date} \@date } }
        \tl_if_empty:NF \@defensedate
          { \@@_thesis_title_row:nn { \defensedatetext } { \usekomafont{date} \@defensedate } }
      }
    \tl_if_empty:NF \l_@@_thesis_title_rows_tl
      {
        { \usekomafont{titleinfo}
          \begin{tabular} { @{} l @{\hspace{1em}} l @{} }
            \l_@@_thesis_title_rows_tl
          \end{tabular} \par }
      }
    \tl_if_empty:NT \@thesis
      { \tl_if_empty:NF \@date { { \usekomafont{date} \@date \par } } }
    \tl_if_empty:NF \@publishers
      { \bigskip { \usekomafont{publishers} \@publishers \par } }
    \@thanks
    \group_end:
  }
%    \end{macrocode}
%
% \dmacro{\maketitle} setzt den Schmutztitel, die Titelseite, die Titelrückseite und die Widmung jeweils auf eigene Seiten.
%    \begin{macrocode}
\RenewDocumentCommand \maketitle { o }
  {
    \group_begin:
    \cs_set_eq:NN \footnote \thanks
    \tl_if_empty:NF \@extratitle
      {
        \cleardoubleoddemptypage
        \thispagestyle{empty}
        \group_begin: \noindent \@extratitle \par \group_end:
        \cleardoubleoddemptypage
      }
    \clearpage
    \IfValueT {#1} { \setcounter { page } {#1} }
    \thispagestyle{empty}
    \@@_thesis_title_page:
    \bool_lazy_and:nnT
      { \tl_if_empty_p:N \@uppertitleback }
      { \tl_if_empty_p:N \@lowertitleback }
      { \legacy_if:nF { @twoside } { \clearpage } }
    \bool_lazy_and:nnF
      { \tl_if_empty_p:N \@uppertitleback }
      { \tl_if_empty_p:N \@lowertitleback }
      {
        \clearpage
        \thispagestyle{empty}
        \group_begin:
          \normalfont \normalsize
          \noindent \begin{minipage}[t]{\textwidth} \@uppertitleback \end{minipage} \par
          \vfill
          \noindent \begin{minipage}[b]{\textwidth} \@lowertitleback \end{minipage} \par
        \group_end:
        \clearpage
      }
    \tl_if_empty:NF \@dedication
      {
        \cleardoubleoddemptypage
        \thispagestyle{empty}
        \null \vfill
        { \centering \usekomafont{dedication} \@dedication \par }
        \vspace { 0pt plus 3fill }
        \clearpage
      }
    \cleardoubleoddemptypage
    \group_end:
    \cs_gset_eq:NN \thanks \use_none:n
  }
%</body&peri>
%    \end{macrocode}
%
% \subsection{Zusammenfassung und Erklärungen}
%
% Beide Umgebungen werden durch eine gemeinsame Maschinerie gesetzt, welche die Logik von \dpkg{tudscr} nachbildet.
% Ein \emph{Teil} ist eine einzelne Zusammenfassung (getrennt durch \dmacro{\nextabstract}) oder
% eine einzelne Erklärung.
%
% \subsubsection{Parameter}
%
% Die optionalen Argumente der Umgebungen und Befehle sind Schlüssel-Wert-Listen.
% Enthält das Argument kein Gleichheitszeichen, so wird es als Wert eines Standardschlüssels interpretiert
% (Sprache bzw.\@ bei einer Zahl die Spaltenanzahl, bei \dmacro{\confirmation} unterstützende Personen
% und bei \dmacro{\blocking} das Unternehmen).
%    \begin{macrocode}
%<*body&peri>
\tl_new:N \l_@@_thesis_fm_kind_tl
\tl_new:N \l_@@_thesis_fm_ps_tl
\tl_new:N \l_@@_thesis_fm_oldps_tl
\tl_new:N \l_@@_thesis_fm_partopts_tl
\tl_new:N \l_@@_thesis_fm_bare_tl
\int_new:N \l_@@_thesis_fm_columns_int
\bool_new:N \l_@@_thesis_fm_titlepage_bool
\bool_new:N \g_@@_thesis_fm_first_bool
\bool_new:N \l_@@_thesis_in_declarations_bool
\msg_new:nnn { tudcd } { thesis/fm-pagestyle }
  { The~page~style~'#1'~is~not~defined. }
\msg_new:nnn { tudcd } { thesis/fm-pagestyle-ignored }
  {
    The~parameter~'pagestyle'~is~ignored,~because~'#1'~is~not~set~on~separate~pages.~
    Use~'#1=chapter'~or~the~KOMA-Script~option~'titlepage'.
  }
\msg_new:nnn { tudcd } { thesis/fm-multicol }
  { The~parameter~'columns'~requires~the~package~'multicol'. }
\msg_new:nnn { tudcd } { thesis/fm-language }
  { The~parameter~'language'~requires~a~language~package~like~'babel'. }
\msg_new:nnn { tudcd } { thesis/fm-tocmultiple }
  { 'tocmultiple'~cannot~be~used~with~'#1=single'~or~'#1=chapter'. }
\msg_new:nnn { tudcd } { thesis/fm-usage }
  { '\iow_char:N\\#1'~can~only~be~used~within~the~environment~'#2'. }
\keys_define:nn { tudcd / thesis / fm }
  {
    language .code:n =
      {
        \cs_if_exist:NTF \selectlanguage
          { \selectlanguage {#1} }
          { \msg_error:nn { tudcd } { thesis/fm-language } }
      },
    columns .int_set:N = \l_@@_thesis_fm_columns_int,
    pagestyle .code:n =
      {
        \bool_if:NTF \l_@@_thesis_fm_titlepage_bool
          {
            \cs_if_exist:cTF { ps@#1 }
              { \tl_set:Nn \l_@@_thesis_fm_ps_tl {#1} }
              { \msg_error:nnn { tudcd } { thesis/fm-pagestyle } {#1} }
          }
          { \msg_warning:nnV { tudcd } { thesis/fm-pagestyle-ignored } \l_@@_thesis_fm_kind_tl }
      },
    markboth .code:n =
      {
        \str_case:nnF {#1}
          {
            { true }
              {
                \bool_set_true:c { l_@@_thesis_ \l_@@_thesis_fm_kind_tl _markboth_bool }
                \tl_if_empty:NT \l_@@_thesis_fm_ps_tl { \tl_set:Nn \l_@@_thesis_fm_ps_tl { headings } }
              }
            { false }
              { \bool_set_false:c { l_@@_thesis_ \l_@@_thesis_fm_kind_tl _markboth_bool } }
          }
          {
            \bool_set_false:c { l_@@_thesis_ \l_@@_thesis_fm_kind_tl _markboth_bool }
            \tl_if_empty:NT \l_@@_thesis_fm_ps_tl { \tl_set:Nn \l_@@_thesis_fm_ps_tl { headings } }
            \manualmark
            \markboth {#1} {#1}
          }
      },
    markboth .default:n = true,
    option .code:n = { \@@_thesis_fm_set:Vn \l_@@_thesis_fm_kind_tl {#1} },
    abstract .meta:n = { option = {#1} },
    declaration .meta:n = { option = {#1} },
    company .code:n = { \tl_set:Nn \@company {#1} },
    supporter .code:n = { \tl_set:Nn \@supporter {#1} },
    place .code:n = { \tl_set:Nn \@place {#1} },
    closing .code:n = { \tl_set:Nn \@confirmationclosing {#1} },
    confirmationclosing .meta:n = { closing = {#1} },
    unknown .code:n = { \@@_thesis_fm_bare:e { \l_keys_key_str } },
  }
\cs_generate_variant:Nn \@@_thesis_fm_set:nn { V }
\cs_new_protected:Npn \@@_thesis_fm_bare:n #1
  {
    \tl_if_empty:NTF \l_@@_thesis_fm_bare_tl
      {
        \regex_match:nnTF { \A \d+ \Z } {#1}
          { \int_set:Nn \l_@@_thesis_fm_columns_int {#1} }
          { \keys_set:nn { tudcd / thesis / fm } { language = {#1} } }
      }
      {
        \use:e
          {
            \keys_set:nn { tudcd / thesis / fm }
              { \l_@@_thesis_fm_bare_tl = { \exp_not:n {#1} } }
          }
      }
  }
\cs_generate_variant:Nn \@@_thesis_fm_bare:n { e }
\cs_new_protected:Npn \@@_thesis_fm_params:n #1
  {
    \tl_if_in:nnTF {#1} { = }
      { \keys_set:nn { tudcd / thesis / fm } {#1} }
      { \tl_if_blank:nF {#1} { \@@_thesis_fm_bare:n {#1} } }
  }
%    \end{macrocode}
%
% \subsubsection{Überschriften}
%
% Die Überschrift eines Teils hängt von der Ebene ab.
% Anschließend werden gegebenenfalls Kolumnentitel und Einträge ins Inhaltsverzeichnis gesetzt.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_thesis_fm_head:n #1
  {
    \int_case:nn { \int_use:c { l_@@_thesis_ \l_@@_thesis_fm_kind_tl _level_int } }
      {
        { 0 }
          {
            \bool_if:NT \l_@@_thesis_fm_titlepage_bool { \par }
            \cs_if_exist_use:N \phantomsection
            \vskip \bigskipamount
            \vskip -\parskip
          }
        { 1 }
          {
            \bool_if:NT \l_@@_thesis_fm_titlepage_bool { \par }
            \cs_if_exist_use:N \phantomsection
            \vskip \bigskipamount
            \vskip -\parskip
            \group_begin:
              \noindent \centering
              \normalfont \sectfont \nobreak #1
              \par
            \group_end:
            \nopagebreak
            \vskip \medskipamount
            \vskip -\parskip
            \@afterheading
          }
        { 2 }
          {
            \section* {#1}
            \cs_if_eq:NNF \@mkboth \use_none:nn { \markright { \MakeMarkcase {#1} } }
          }
        { 3 }
          {
            \chapter* {#1}
            \markboth { \MakeMarkcase {#1} } { \MakeMarkcase {#1} }
          }
      }
    \bool_if:cT { l_@@_thesis_ \l_@@_thesis_fm_kind_tl _markboth_bool }
      { \markboth { \MakeMarkcase {#1} } { \MakeMarkcase {#1} } }
    \int_case:nn { \int_use:c { l_@@_thesis_ \l_@@_thesis_fm_kind_tl _toc_int } }
      {
        { 1 } { \cs_if_exist_use:N \phantomsection \addchaptertocentry { } {#1} }
        { 2 } { \cs_if_exist_use:N \phantomsection \addsectiontocentry { } {#1} }
      }
  }
%    \end{macrocode}
%
% \subsubsection{Teile}
%
% Vor jedem Teil wird der vertikale Abstand bzw.\@ der Seitenumbruch gesetzt.
% Werden mehrere Teile gemeinsam auf einer Seite gesetzt (\dcode{multiple}), so werden sie
% bei \dcode{fil} gleichmäßig vertikal verteilt, ansonsten beginnt jeder Teil auf einer neuen Seite.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_thesis_fm_separate:
  {
    \legacy_if:nF { @twocolumn }
      {
        \bool_if:NT \l_@@_thesis_fm_titlepage_bool
          {
            \bool_if:NTF \g_@@_thesis_fm_first_bool
              {
                \bool_if:cT { l_@@_thesis_ \l_@@_thesis_fm_kind_tl _fil_bool }
                  { \null \vfil }
              }
              {
                \bool_if:cTF { l_@@_thesis_ \l_@@_thesis_fm_kind_tl _multi_bool }
                  {
                    \bool_if:cT { l_@@_thesis_ \l_@@_thesis_fm_kind_tl _fil_bool }
                      { \vfil }
                  }
                  {
                    \bool_if:cTF { l_@@_thesis_ \l_@@_thesis_fm_kind_tl _fil_bool }
                      { \vfil \null \clearpage \null \vfil }
                      { \clearpage }
                  }
              }
          }
      }
    \bool_gset_false:N \g_@@_thesis_fm_first_bool
  }
%    \end{macrocode}
% Ein Teil wird in Zitatform (\denv{quotation}, bzw.\@ \denv{quoting} falls geladen) gesetzt, wenn er
% weder auf eigener Seite steht noch eine Gliederungsüberschrift besitzt. Bei mehreren Spalten wird die
% Überschrift über die Spalten gesetzt.
%    \begin{macrocode}
\tl_new:N \l_@@_thesis_fm_quoting_tl
\tl_set:Nn \l_@@_thesis_fm_quoting_tl { quotation }
\hook_gput_code:nnn { package/quoting/after } { tudcd/thesis }
  { \tl_set:Nn \l_@@_thesis_fm_quoting_tl { quoting } }
\cs_new_protected:Npn \@@_thesis_fm_part_start:nn #1#2
  {
    \group_begin:
      \@@_thesis_fm_params:n {#1}
      \@@_thesis_fm_separate:
      \bool_lazy_and:nnT
        { ! \l_@@_thesis_fm_titlepage_bool }
        { \int_compare_p:nNn { \int_use:c { l_@@_thesis_ \l_@@_thesis_fm_kind_tl _level_int } } < { 2 } }
        { \legacy_if:nF { @twocolumn } { \exp_args:NV \begin \l_@@_thesis_fm_quoting_tl } }
      \int_compare:nNnTF \l_@@_thesis_fm_columns_int > { 1 }
        {
          \vspace { -\multicolsep }
          \begin{multicols} { \l_@@_thesis_fm_columns_int } [ \@@_thesis_fm_head:n {#2} ]
        }
        { \@@_thesis_fm_head:n {#2} }
  }
\cs_new_protected:Npn \@@_thesis_fm_part_end:
  {
      \int_compare:nNnTF \l_@@_thesis_fm_columns_int > { 1 }
        {
          \end{multicols}
          \vspace { -\multicolsep }
        }
        { \par }
      \bool_lazy_and:nnT
        { ! \l_@@_thesis_fm_titlepage_bool }
        { \int_compare_p:nNn { \int_use:c { l_@@_thesis_ \l_@@_thesis_fm_kind_tl _level_int } } < { 2 } }
        { \legacy_if:nF { @twocolumn } { \exp_args:NV \end \l_@@_thesis_fm_quoting_tl \par } }
    \group_end:
  }
\cs_new_protected:Npn \@@_thesis_fm_part:nnn #1#2#3
  {
    \@@_thesis_fm_part_start:nn {#1} {#2}
      #3
    \@@_thesis_fm_part_end:
  }
%    \end{macrocode}
%
% \subsubsection{Die gemeinsame Umgebung}
%
% Die Umgebungen setzen den Inhalt \dcode{\#3} der Art \dcode{\#1} mit den Parametern \dcode{\#2}.
% Die Ebene \dcode{chapter} erzwingt eigene Seiten, auf welchen jeder Teil einzeln und ohne vertikale Zentrierung steht.
% Bei \dcode{tocmultiple} wird der Inhalt vorab in einer Box gesetzt, um die Überschriften aller Teile
% für einen gemeinsamen Eintrag im Inhaltsverzeichnis zu sammeln.
%    \begin{macrocode}
\tl_new:N \g_@@_thesis_fm_toc_tl
\cs_new_protected:Npn \@@_thesis_fm_env:nnn #1#2#3
  {
    \group_begin:
    \tl_set:Nn \l_@@_thesis_fm_kind_tl {#1}
    \tl_clear:N \l_@@_thesis_fm_ps_tl
    \int_set:Nn \l_@@_thesis_fm_columns_int { 1 }
    \legacy_if:nTF { @titlepage }
      { \bool_set_true:N \l_@@_thesis_fm_titlepage_bool }
      { \bool_set_false:N \l_@@_thesis_fm_titlepage_bool }
    \int_compare:nNnT { \int_use:c { l_@@_thesis_#1_level_int } } = { 3 }
      {
        \bool_set_true:N \l_@@_thesis_fm_titlepage_bool
        \bool_set_false:c { l_@@_thesis_#1_multi_bool }
        \bool_set_false:c { l_@@_thesis_#1_fil_bool }
      }
    \@@_thesis_fm_params:n {#2}
    \bool_lazy_and:nnT
      { \int_compare_p:nNn \l_@@_thesis_fm_columns_int > { 1 } }
      { ! \cs_if_exist_p:N \multicols }
      {
        \msg_error:nn { tudcd } { thesis/fm-multicol }
        \int_set:Nn \l_@@_thesis_fm_columns_int { 1 }
      }
    \bool_if:NT \l_@@_thesis_fm_titlepage_bool
      {
        \clearpage
        \tl_set:Ne \l_@@_thesis_fm_oldps_tl { \currentpagestyle }
        \tl_if_empty:NTF \l_@@_thesis_fm_ps_tl
          { \pagestyle { empty } }
          { \pagestyle { \l_@@_thesis_fm_ps_tl } }
      }
    \int_compare:nNnT { \int_use:c { l_@@_thesis_#1_toc_int } } > { 2 }
      { \@@_thesis_fm_toc_multiple:nn {#1} {#3} }
    \bool_gset_true:N \g_@@_thesis_fm_first_bool
    #3
    \bool_if:NTF \l_@@_thesis_fm_titlepage_bool
      {
        \bool_if:cT { l_@@_thesis_#1_fil_bool } { \vfil \null }
        \clearpage
        \exp_args:NV \pagestyle \l_@@_thesis_fm_oldps_tl
      }
      {
        \int_compare:nNnT { \int_use:c { l_@@_thesis_#1_level_int } } = { 2 }
          { \vskip \bigskipamount \vskip -\parskip }
      }
    \group_end:
  }
\cs_new_protected:Npn \@@_thesis_fm_toc_multiple:nn #1#2
  {
    \bool_if:cTF { l_@@_thesis_#1_multi_bool }
      {
        \tl_gclear:N \g_@@_thesis_fm_toc_tl
        \group_begin:
          \cs_set_eq:NN \clearpage \scan_stop:
          \cs_set_eq:NN \addtocentrydefault \use_none:nnn
          \cs_set_protected:Npn \@@_thesis_fm_head:n ##1
            {
              \protected@xdef \g_@@_thesis_fm_toc_tl
                {
                  \tl_if_empty:NF \g_@@_thesis_fm_toc_tl { \g_@@_thesis_fm_toc_tl / }
                  ##1
                }
            }
          \vbox_set:Nn \l_@@_thesis_tmp_box {#2}
        \group_end:
        \tl_if_empty:NF \g_@@_thesis_fm_toc_tl
          {
            \cs_if_exist_use:N \phantomsection
            \int_compare:nNnTF { \int_use:c { l_@@_thesis_#1_toc_int } } = { 3 }
              { \exp_args:NnV \addchaptertocentry { } \g_@@_thesis_fm_toc_tl }
              { \exp_args:NnV \addsectiontocentry { } \g_@@_thesis_fm_toc_tl }
          }
      }
      {
        \msg_warning:nnn { tudcd } { thesis/fm-tocmultiple } {#1}
        \int_sub:cn { l_@@_thesis_#1_toc_int } { 2 }
      }
  }
%    \end{macrocode}
%
% \subsubsection{Die Zusammenfassung}
%
% \begin{codedescribe}[env,new=0.8.0]{abstract}
% \begin{codesyntax}
% \tsmacro{\begin{abstract}}[Parameter]
% \ldots
% \tsmacro{\nextabstract}[Parameter]
% \ldots
% \tsmacro{\end{abstract}}{}
% \end{codesyntax}
% Setzt eine oder mehrere Zusammenfassungen. Mit \dmacro{\nextabstract} wird die nächste Zusammenfassung,
% üblicherweise in einer anderen Sprache, begonnen. Mögliche Parameter sind
% \dcode{language}, \dcode{columns}, \dcode{pagestyle}, \dcode{markboth} und \dcode{option}
% (bzw.\@ \dcode{abstract}), welches die Werte der Klassenoption \doption{abstract} lokal setzt.
% \end{codedescribe}
%    \begin{macrocode}
\NewDocumentCommand \nextabstract { O{} }
  { \msg_error:nnnn { tudcd } { thesis/fm-usage } { nextabstract } { abstract } }
\DeclareDocumentEnvironment { abstract } { O{} +b }
  {
    \@@_thesis_fm_env:nnn { abstract } {#1}
      {
        \RenewDocumentCommand \nextabstract { O{} }
          {
            \@@_thesis_fm_part_end:
            \@@_thesis_fm_part_start:nn {##1} { \abstractname }
          }
        \@@_thesis_fm_part:nnn {#1} { \abstractname } {#2}
      }
  }
  { }
%    \end{macrocode}
%
% \subsubsection{Die Erklärungen}
%
% \begin{codedescribe}[env,new=0.8.0]{declarations}
% \begin{codesyntax}
% \tsmacro{\begin{declarations}}[Parameter]
% \ldots
% \tsmacro{\end{declarations}}{}
% \end{codesyntax}
% Fasst mehrere Erklärungen zusammen. Neben den Parametern der Zusammenfassung sind
% \dcode{company}, \dcode{supporter}, \dcode{place} und \dcode{closing} möglich.
% \end{codedescribe}
%    \begin{macrocode}
\DeclareDocumentEnvironment { declarations } { O{} +b }
  {
    \@@_thesis_fm_env:nnn { declaration } {#1}
      {
        \bool_set_true:N \l_@@_thesis_in_declarations_bool
        \cs_set:Npn \and { , ~ }
        \cs_set_eq:NN \thanks \use_none:n
        #2
      }
  }
  { }
%    \end{macrocode}
%
% Wird ein Befehl für eine Erklärung außerhalb der Umgebung genutzt, so wird diese implizit geöffnet.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_thesis_declaration:nn #1#2
  {
    \bool_if:NTF \l_@@_thesis_in_declarations_bool
      {
        \tl_set:Nn \l_@@_thesis_fm_partopts_tl {#1}
        #2
      }
      {
        \tl_clear:N \l_@@_thesis_fm_partopts_tl
        \begin{declarations} [#1] #2 \end{declarations}
      }
  }
\cs_new_protected:Npn \@@_thesis_declaration_part:nn #1#2
  { \exp_args:NV \@@_thesis_fm_part:nnn \l_@@_thesis_fm_partopts_tl {#1} {#2} }
%    \end{macrocode}
%
% \begin{codedescribe}[macro,new=0.8.0]{\confirmation,\blocking,\declaration,\nextdeclaration}
% \begin{codesyntax}
% \tsmacro{\confirmation}[Parameter]
%
% \tsmacro{\blocking}[Parameter]
%
% \tsmacro{\declaration}[Parameter]
%
% \tsmacro{\nextdeclaration}[Parameter]{Überschrift,Text}
% \end{codesyntax}
% \dmacro{\confirmation} setzt die Selbstständigkeitserklärung, \dmacro{\blocking} den Sperrvermerk und
% \dmacro{\declaration} beide. Bei den gesternten Varianten werden die Betreuenden als unterstützende Personen genannt.
% \dmacro{\nextdeclaration} setzt eine eigene Erklärung und ist nur innerhalb von \denv{declarations} erlaubt.
% \end{codedescribe}
%
% Der Abschluss der Selbstständigkeitserklärung besteht aus Ort, Datum und je einer Unterschriftenzeile pro Autor.
%    \begin{macrocode}
\tl_gset:Nn \@confirmationclosing { \@@_thesis_confirmation_closing: }
\cs_new_protected:Npn \@@_thesis_confirmation_closing:
  {
    \tl_if_empty:NF \@date
      {
        \par \medskip \noindent
        \tl_if_empty:NF \@place { \@place , \nobreakspace }
        \@date
      }
    \par
    \vspace { 3 \baselineskip }
    \noindent
    \seq_if_empty:NTF \g_@@_thesis_author_seq
      { \@@_thesis_signature:n { \@author } }
      {
        \seq_map_indexed_inline:Nn \g_@@_thesis_author_seq
          {
            \int_compare:nNnF {##1} = { 1 } { \hfill }
            \@@_thesis_signature:n {##2}
          }
      }
    \par
  }
\cs_new_protected:Npn \@@_thesis_signature:n #1
  {
    \parbox[t] { 0.4 \linewidth }
      { \rule { \linewidth } { 0.4pt } \\ \small #1 }
  }
\cs_new_protected:Npn \@@_thesis_declaration_opts:nn #1#2
  {
    \tl_set:Nn \l_@@_thesis_tmp_tl {#2}
    \bool_lazy_and:nnT {#1} { ! \tl_if_empty_p:N \@supervisor }
      { \tl_put_left:Ne \l_@@_thesis_tmp_tl { supporter = { \exp_not:o \@supervisor } , } }
  }
\cs_new_protected:Npn \@@_thesis_confirmation_part:
  {
    \@@_thesis_declaration_part:nn { \confirmationname }
      { \confirmationtext \par \@confirmationclosing }
  }
\cs_new_protected:Npn \@@_thesis_blocking_part:
  { \@@_thesis_declaration_part:nn { \blockingname } { \blockingtext } }
\NewDocumentCommand \confirmation { s O{} }
  {
    \group_begin:
      \tl_set:Nn \l_@@_thesis_fm_bare_tl { supporter }
      \@@_thesis_declaration_opts:nn {#1} {#2}
      \exp_args:NV \@@_thesis_declaration:nn \l_@@_thesis_tmp_tl
        { \@@_thesis_confirmation_part: }
    \group_end:
  }
\NewDocumentCommand \blocking { O{} }
  {
    \group_begin:
      \tl_set:Nn \l_@@_thesis_fm_bare_tl { company }
      \@@_thesis_declaration:nn {#1} { \@@_thesis_blocking_part: }
    \group_end:
  }
\NewDocumentCommand \declaration { s O{} }
  {
    \group_begin:
      \@@_thesis_declaration_opts:nn {#1} {#2}
      \exp_args:NV \@@_thesis_declaration:nn \l_@@_thesis_tmp_tl
        {
          \@@_thesis_confirmation_part:
          \@@_thesis_blocking_part:
        }
    \group_end:
  }
\NewDocumentCommand \nextdeclaration { O{} m m }
  {
    \bool_if:NTF \l_@@_thesis_in_declarations_bool
      { \@@_thesis_fm_part:nnn {#1} {#2} {#3} }
      { \msg_error:nnnn { tudcd } { thesis/fm-usage } { nextdeclaration } { declarations } }
  }
%</body&peri>
%    \end{macrocode}
