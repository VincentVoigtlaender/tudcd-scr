% \subsection{Eingabefelder}
%
% Die Felder werden wie bei \dpkg{tudscr} in Makros der Form \dcode{\textbackslash @<Feld>} gespeichert,
% damit eigene Texte (beispielsweise mittels \dmacro{\renewcaptionname}) über \dmacro{\getfield} darauf zugreifen können.
%
% \begin{codedescribe}[macro,new=0.8.0]{\faculty,\department,\institute,\chair}
% \begin{codesyntax}
% \tsmacro{\faculty}[ignoriert]{Fakultät}
% \end{codesyntax}
% Die Organisationseinheiten werden auf der Titelseite unter dem Logo ausgegeben.
% Das optionale Argument wird aus Kompatibilitätsgründen akzeptiert und ignoriert.
% \end{codedescribe}
%    \begin{macrocode}
%<*body&peri>
\cs_new_protected:Npn \@@_thesis_new_field:nn #1#2
  {
    \tl_gclear_new:c { @#1 }
    \tl_gset:cn { @#1 } {#2}
  }
\clist_map_inline:nn { faculty, department, institute, chair }
  {
    \@@_thesis_new_field:nn {#1} { }
    \exp_args:Nc \NewDocumentCommand { #1 } { o m }
      { \tl_gset:cn { @#1 } {##2} }
  }
%    \end{macrocode}
%
% \begin{codedescribe}[macro,new=0.8.0]{\supervisor,\professor,\referee,\advisor,\company,\defensedate,\place,\confirmationclosing}
% \begin{codesyntax}
% \tsmacro{\supervisor}{Name \textbackslash and Name}
% \end{codesyntax}
% Betreuende, Hochschullehrende, Gutachtende und Fachreferenten werden mit \dmacro{\and} getrennt.
% \dmacro{\company} wird im Sperrvermerk, \dmacro{\place} (Voreinstellung: Dresden) und
% \dmacro{\confirmationclosing} in der Selbstständigkeitserklärung verwendet.
% \end{codedescribe}
%    \begin{macrocode}
\clist_map_inline:nn
  { supervisor, professor, referee, advisor, company, defensedate, place }
  {
    \@@_thesis_new_field:nn {#1} { }
    \exp_args:Nc \NewDocumentCommand { #1 } { m }
      { \tl_gset:cn { @#1 } {##1} }
  }
\tl_gset:Nn \@place { Dresden }
\@@_thesis_new_field:nn { supporter } { }
\NewDocumentCommand \confirmationclosing { m }
  { \tl_gset:Nn \@confirmationclosing {#1} }
%    \end{macrocode}
