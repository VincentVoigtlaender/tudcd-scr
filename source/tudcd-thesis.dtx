% \subsubsection{Angaben zu den Autoren}
%
% \begin{codedescribe}[macro,new=0.8.0]{\matriculationnumber,\matriculationyear,\dateofbirth,\placeofbirth,\course,\discipline,\emailaddress,\authormore}
% \begin{codesyntax}
% \tsmacro{\matriculationnumber}{Matrikelnummer}
%
% \tsmacro{\emailaddress}[ignoriert]{E-Mail-Adresse}
% \end{codesyntax}
% Die Angaben können außerhalb von \dmacro{\author} für alle Autoren oder innerhalb von \dmacro{\author}
% direkt nach dem jeweiligen Namen für einzelne Autoren gesetzt werden.
% Bei der gesternten Variante von \dmacro{\emailaddress} wird die Adresse nicht verlinkt.
% \end{codedescribe}
%
% Außerhalb von \dmacro{\author} speichern die Befehle den Wert global.
%    \begin{macrocode}
%<*body&peri>
\clist_const:Nn \c_@@_thesis_authorfields_clist
  {
    matriculationnumber, matriculationyear, dateofbirth, placeofbirth,
    course, discipline, emailaddress, authormore
  }
\clist_map_inline:Nn \c_@@_thesis_authorfields_clist
  { \@@_thesis_new_field:nn {#1} { } }
\bool_new:N \g_@@_thesis_emailaddress_nolink_bool
\clist_map_inline:nn
  {
    matriculationnumber, matriculationyear, dateofbirth, placeofbirth,
    course, discipline, authormore
  }
  {
    \exp_args:Nc \NewDocumentCommand { #1 } { m }
      { \tl_gset:cn { @#1 } {##1} }
  }
\NewDocumentCommand \emailaddress { s o m }
  {
    \tl_gset:Nn \@emailaddress {#3}
    \bool_gset:Nn \g_@@_thesis_emailaddress_nolink_bool {#1}
  }
%    \end{macrocode}
%
% Innerhalb von \dmacro{\author} wird die Liste beim Aufruf an \dmacro{\and} getrennt.
% Für jeden Autor werden die Angaben zweimal ausgewertet:
% Einmal in einer Box, in welcher die Befehle ihren Wert in einer Eigenschaftsliste je Autor ablegen,
% und einmal expandierend, wobei die Befehle samt Argument entfernt werden und nur der Name übrig bleibt.
% \dcode{\textbackslash @author} enthält anschließend nur die Namen, getrennt durch \dmacro{\and}.
%    \begin{macrocode}
\seq_new:N \g_@@_thesis_author_seq
\int_new:N \g_@@_thesis_author_int
\seq_new:N \l_@@_thesis_tmp_seq
\box_new:N \l_@@_thesis_tmp_box
\cs_new_protected:Npn \@@_thesis_author_collect:
  {
    \clist_map_inline:Nn \c_@@_thesis_authorfields_clist
      {
        \cs_set_protected:cpn {##1} ####1
          {
            \prop_gput:cnn
              { g_@@_thesis_author_ \int_use:N \g_@@_thesis_author_int _prop }
              {##1} {####1}
          }
      }
    \DeclareDocumentCommand \emailaddress { s o m }
      {
        \prop_gput:cnn
          { g_@@_thesis_author_ \int_use:N \g_@@_thesis_author_int _prop }
          { emailaddress } {##3}
        \IfBooleanT {##1}
          {
            \prop_gput:cnn
              { g_@@_thesis_author_ \int_use:N \g_@@_thesis_author_int _prop }
              { emailaddressnolink } { }
          }
      }
  }
\cs_new_protected:Npn \@@_thesis_author_strip:
  {
    \clist_map_inline:Nn \c_@@_thesis_authorfields_clist
      { \cs_set:cpn {##1} ####1 { } }
    \DeclareExpandableDocumentCommand \emailaddress { s o m } { }
  }
\cs_new_protected:Npn \@@_thesis_author_parse:n #1
  {
    \seq_gclear:N \g_@@_thesis_author_seq
    \int_gzero:N \g_@@_thesis_author_int
    \seq_set_split:Nnn \l_@@_thesis_tmp_seq { \and } {#1}
    \seq_map_inline:Nn \l_@@_thesis_tmp_seq
      {
        \int_gincr:N \g_@@_thesis_author_int
        \prop_gclear_new:c
          { g_@@_thesis_author_ \int_use:N \g_@@_thesis_author_int _prop }
        \group_begin:
          \@@_thesis_author_collect:
          \cs_set_eq:NN \thanks \use_none:n
          \hbox_set:Nn \l_@@_thesis_tmp_box {##1}
        \group_end:
        \group_begin:
          \@@_thesis_author_strip:
          \protected@edef \l_@@_thesis_tmp_tl {##1}
          \tl_set:Ne \l_@@_thesis_tmp_tl { \tl_trim_spaces:V \l_@@_thesis_tmp_tl }
          \seq_gput_right:NV \g_@@_thesis_author_seq \l_@@_thesis_tmp_tl
        \group_end:
      }
    \tl_gset:Ne \@author
      { \seq_use:Nn \g_@@_thesis_author_seq { \exp_not:N \and } }
  }
\RenewDocumentCommand \author { m } { \@@_thesis_author_parse:n {#1} }
%    \end{macrocode}
%
% Ein Feld eines Autors wird aus dessen Eigenschaftsliste gelesen,
% ist es dort nicht vorhanden, wird der globale Wert verwendet.
%    \begin{macrocode}
\cs_new_protected:Npn \@@_thesis_author_get:nnN #1#2#3
  {
    \prop_get:cnNF { g_@@_thesis_author_ #1 _prop } {#2} #3
      { \tl_set_eq:Nc #3 { @#2 } }
  }
%</body&peri>
%    \end{macrocode}
