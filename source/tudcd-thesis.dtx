% Gibt den Inhalt eines Feldes aus, beispielsweise \dcode{\textbackslash getfield\{title\}}.
% Ist ein \tsobj[oarg]{Befehl} angegeben, wird diesem der Inhalt als Argument übergeben.
% \end{codedescribe}
%    \begin{macrocode}
\msg_new:nnn { tudcd } { thesis/unknown-field }
  { The~field~'#1'~is~unknown~and~cannot~be~printed. }
\NewExpandableDocumentCommand \getfield { o m }
  {
    \cs_if_exist:cTF { @#2 }
      { \IfValueTF {#1} { #1 { \use:c { @#2 } } } { \use:c { @#2 } } }
