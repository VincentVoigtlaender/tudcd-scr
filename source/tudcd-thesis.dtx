%
% \section{\texttt{tudcd-thesis}: Die Klasse für Abschlussarbeiten}
%
% \subsection{Vorbemerkung}
%
% Die Klasse \dcode{tudcdthesis} ist eine schlanke Hülle um die \KOMAScript-Klasse \dcode{scrbook}.
% Sie ersetzt die Klasse \dcode{tudscrreprt} aus dem \dpkg{tudscr}-Bündel und übernimmt
% deren inhaltliche Schnittstelle (Eingabefelder, Titelseite, Zusammenfassung und Erklärungen),
% nicht jedoch deren Layoutoptionen.
%
% Im Gegensatz zu den übrigen Klassen des \TUDCDScript{} werden
% \begin{itemize}
%   \item der Satzspiegel durch \dpkg{typearea} bestimmt (\doption{BCOR} und \doption{DIV} sind erlaubt),
%   \item der Fließtext in Computer Modern (Latin Modern) gesetzt und lediglich die Auszeichnungsschriften
%         (Überschriften, Titel, Kolumnentitel) in Noto Sans, sowie
%   \item die Seitenstile von \dpkg{scrlayer-scrpage} ohne Logo verwendet.
% \end{itemize}
%
% Aus den gemeinsamen Modulen werden lediglich \texttt{tudcd-common} (Optionen, Logo),
% \texttt{tudcd-documents} (Identifikation, Basisklasse) und \texttt{tudcd-colors} (Farben) genutzt.
%
%    \begin{macrocode}
%<@@=tudcd>
%    \end{macrocode}
%
% \subsection{Optionen}
%
% \subsubsection{Ausgabemedium}
%
% \begin{codedescribe}[option,new=0.8.0]{output}
% \begin{codesyntax}
% \tsobj[key]{output}=\tsobj[value]{digital,print}
% \end{codesyntax}
% Die globale Option \doption{output} legt fest, ob die Arbeit für die Ansicht am Bildschirm
% (\dcode{digital}, Voreinstellung) oder für den Druck (\dcode{print}) gesetzt wird.
%
% Für \dcode{digital} wird einseitig (\doption{oneside}) gesetzt und alle Elemente des Corporate Designs
% erscheinen in Brilliantblau.
%
% Für \dcode{print} werden die \KOMAScript-Optionen \doption{twoside}, \doption{open}\dcode{=right},
% \doption{cleardoublepage}\dcode{=empty} und \doption{BCOR}\dcode{=10mm} voreingestellt.
% Zudem werden Überschriften, Titel, Kolumnentitel, Verweise und das Logo schwarz gesetzt,
% um farbige Druckseiten zu vermeiden.
%
% Die Voreinstellungen werden nur dann gesetzt, wenn die jeweilige Option nicht explizit
% in \dmacro{\documentclass} angegeben worden ist.
% \end{codedescribe}
%
% Die Wahl wird in einer Zeichenkette gespeichert.
% Weiterhin wird eine Liste der durch Nutzende explizit gesetzten \KOMAScript-Optionen benötigt,
% welche in \texttt{tudcd-documents} befüllt wird.
%    \begin{macrocode}
%<*prelim-declaration>
\str_new:N \l_@@_thesis_output_str
\clist_new:N \g_@@_thesis_user_koma_clist
\bool_new:N \l_@@_thesis_bodyfont_noto_bool
%</prelim-declaration>
%    \end{macrocode}
%
% Wird \dcode{print} gewählt, werden die Hervorhebungsfarbe und die Farbe des Logos auf Schwarz gesetzt.
% Werden \doption{color/highlight-color} oder \doption{logo/color} später gesetzt, so überschreiben diese die Voreinstellung.
%    \begin{macrocode}
%<*option&peri>
  output .choices:nn = { digital, print }
    {
      \str_set:NV \l_@@_thesis_output_str \l_keys_choice_tl
      \str_if_eq:VnT \l_keys_choice_tl { print }
        {
          \tl_set:Nn \l_@@_highlight_color_tl { Schwarz }
          \str_set:Nn \l_@@_logocolor_str { black }
        }
    },
  output .initial:n = digital,
  output .usage:n = load,
%</option&peri>
%    \end{macrocode}
%
% \subsubsection{Schrift des Fließtextes}
%
% \begin{codedescribe}[option,new=0.8.0]{bodyfont}
% \begin{codesyntax}
% \tsobj[key]{bodyfont}=\tsobj[value]{cm,noto}
% \end{codesyntax}
% Der Fließtext wird per Voreinstellung (\dcode{cm}) in Computer Modern gesetzt, da diese Schrift
% für lange Texte gut lesbar ist. Mit \dcode{noto} wird auch der Fließtext in Noto Sans gesetzt.
% Der Mathematiksatz bleibt in beiden Fällen unverändert.
% \end{codedescribe}
%    \begin{macrocode}
%<*option&peri>
  bodyfont .choices:nn = { cm, noto }
    {
      \str_if_eq:VnTF \l_keys_choice_tl { noto }
        { \bool_set_true:N \l_@@_thesis_bodyfont_noto_bool }
        { \bool_set_false:N \l_@@_thesis_bodyfont_noto_bool }
    },
  bodyfont .initial:n = cm,
  bodyfont .usage:n = preamble,
%</option&peri>
%    \end{macrocode}
%
% \subsubsection{Zusammenfassung und Erklärungen}
%
% \begin{codedescribe}[option,new=0.8.0]{abstract,declaration}
% \begin{codesyntax}
% \tsobj[key]{abstract}=\tsobj[value]{Werteliste}
%
% \tsobj[key]{declaration}=\tsobj[value]{Werteliste}
% \end{codesyntax}
% Die beiden Optionen steuern das Aussehen der Umgebungen \denv{abstract} und \denv{declarations}.
% Sie verstehen dieselben Werte wie die gleichnamigen Optionen von \dpkg{tudscr}, inklusive aller Synonyme:
% \begin{description}
%   \item[\dcode{false}] keine Überschrift,
%   \item[\dcode{true}] zentrierte Überschrift (Voreinstellung),
%   \item[\dcode{section}] Überschrift mit \dmacro{\section*},
%   \item[\dcode{chapter}] Überschrift mit \dmacro{\chapter*},
%   \item[\dcode{single}, \dcode{multiple}] jeder Teil auf eigener Seite oder alle Teile gemeinsam,
%   \item[\dcode{fil}, \dcode{nofil}] vertikale Zentrierung auf der Seite,
%   \item[\dcode{markboth}, \dcode{nomarkboth}] Setzen der Kolumnentitel,
%   \item[\dcode{nottotoc}, \dcode{totoc}, \dcode{totocleveldown}, \dcode{tocmultiple}] Einträge im Inhaltsverzeichnis.
% \end{description}
% \end{codedescribe}
%
% Für beide Optionen wird ein gemeinsamer Zustand angelegt.
%    \begin{macrocode}
%<*prelim-declaration>
\clist_map_inline:nn { abstract, declaration }
  {
    \int_new:c { l_@@_thesis_#1_level_int }
    \int_new:c { l_@@_thesis_#1_toc_int }
    \bool_new:c { l_@@_thesis_#1_toc_locked_bool }
    \bool_new:c { l_@@_thesis_#1_multi_bool }
    \bool_new:c { l_@@_thesis_#1_fil_bool }
    \bool_new:c { l_@@_thesis_#1_markboth_bool }
    \int_set:cn { l_@@_thesis_#1_level_int } { 1 }
    \bool_set_true:c { l_@@_thesis_#1_multi_bool }
    \bool_set_true:c { l_@@_thesis_#1_fil_bool }
  }
%    \end{macrocode}
% Die Synonyme der Werte werden auf einen kanonischen Wert abgebildet.
%    \begin{macrocode}
\prop_new:N \g_@@_thesis_fm_alias_prop
\cs_generate_variant:Nn \prop_get:NnNTF { Ne }
\cs_set_protected:Npn \@@_thesis_tmp:nn #1#2
  {
    \clist_map_inline:nn {#2}
      { \prop_gput:Nnn \g_@@_thesis_fm_alias_prop {##1} {#1} }
  }
\@@_thesis_tmp:nn { false } { false, off, no }
\@@_thesis_tmp:nn { true } { true, on, yes }
\@@_thesis_tmp:nn { section } { section, sect, sec, addsec }
\@@_thesis_tmp:nn { chapter } { chapter, chap, addchap, heading, new, standard }
\@@_thesis_tmp:nn { single } { single, one, simple }
\@@_thesis_tmp:nn { multiple } { multiple, multi, all, aggregate, two, both, double }
\@@_thesis_tmp:nn { nofil } { nofil, nofill, novfil, novfill }
\@@_thesis_tmp:nn { fil } { fil, fill, vfil, vfill }
\@@_thesis_tmp:nn { markboth } { markboth, mark }
\@@_thesis_tmp:nn { nomarkboth } { nomarkboth, nomark }
\@@_thesis_tmp:nn { nottotoc } { nottotoc, notoc }
\@@_thesis_tmp:nn { totoc } { totoc, toc, totoclevelup, toclevelup, levelup }
\@@_thesis_tmp:nn { totocleveldown } { totocleveldown, tocleveldown, leveldown }
\@@_thesis_tmp:nn { tocmultiple }
  {
    tocmultiple, tocmulti, tocall, tocaggregate,
    totocmultiple, totocmulti, totocall, totocaggregate
  }
%    \end{macrocode}
% Die Ebene der Überschrift gibt den Eintrag ins Inhaltsverzeichnis vor, sofern dieser nicht explizit gesetzt worden ist.
% Die Zahlenwerte entsprechen denen von \dpkg{tudscr}: Ebene $0$ bis $3$ für \dcode{false} bis \dcode{chapter},
% Inhaltsverzeichnis $0$ (kein Eintrag), $1$ (oberste Ebene), $2$ (eine Ebene tiefer) sowie $3$ und $4$ für
% einen gemeinsamen Eintrag aller Teile.
%    \begin{macrocode}
\msg_new:nnnn { tudcd } { thesis/fm-value }
  { Unknown~value~'#2'~for~option~'#1'. }
  { See~the~tudcdscr~handbook~for~the~values~of~the~'#1'~option. }
\cs_new_protected:Npn \@@_thesis_fm_toc_preset:nn #1#2
  {
    \bool_if:cF { l_@@_thesis_#1_toc_locked_bool }
      { \int_set:cn { l_@@_thesis_#1_toc_int } {#2} }
  }
\cs_new_protected:Npn \@@_thesis_fm_toc_set:nn #1#2
  {
    \int_set:cn { l_@@_thesis_#1_toc_int } {#2}
    \bool_set_true:c { l_@@_thesis_#1_toc_locked_bool }
  }
\cs_new_protected:Npn \@@_thesis_fm_set:nn #1#2
  {
    \clist_map_inline:nn {#2}
      {
        \prop_get:NeNTF \g_@@_thesis_fm_alias_prop { \tl_to_str:n {##1} } \l_@@_thesis_tmp_tl
          { \@@_thesis_fm_apply:nV {#1} \l_@@_thesis_tmp_tl }
          { \msg_error:nnnn { tudcd } { thesis/fm-value } {#1} {##1} }
      }
  }
\tl_new:N \l_@@_thesis_tmp_tl
\cs_new_protected:Npn \@@_thesis_fm_apply:nn #1#2
  {
    \str_case:nn {#2}
      {
        { false }
          {
            \int_set:cn { l_@@_thesis_#1_level_int } { 0 }
            \@@_thesis_fm_toc_preset:nn {#1} { 0 }
          }
        { true }
          {
            \int_set:cn { l_@@_thesis_#1_level_int } { 1 }
            \@@_thesis_fm_toc_preset:nn {#1} { 0 }
          }
        { section }
          {
            \int_set:cn { l_@@_thesis_#1_level_int } { 2 }
            \@@_thesis_fm_toc_preset:nn {#1} { 1 }
          }
        { chapter }
          {
            \int_set:cn { l_@@_thesis_#1_level_int } { 3 }
            \@@_thesis_fm_toc_preset:nn {#1} { 1 }
          }
        { single } { \bool_set_false:c { l_@@_thesis_#1_multi_bool } }
        { multiple } { \bool_set_true:c { l_@@_thesis_#1_multi_bool } }
        { nofil } { \bool_set_false:c { l_@@_thesis_#1_fil_bool } }
        { fil } { \bool_set_true:c { l_@@_thesis_#1_fil_bool } }
        { markboth } { \bool_set_true:c { l_@@_thesis_#1_markboth_bool } }
        { nomarkboth } { \bool_set_false:c { l_@@_thesis_#1_markboth_bool } }
        { nottotoc } { \@@_thesis_fm_toc_set:nn {#1} { 0 } }
        { totoc }
          {
            \@@_thesis_fm_toc_set:nn {#1}
              { \int_compare:nNnTF { \int_use:c { l_@@_thesis_#1_toc_int } } < { 3 } { 1 } { 3 } }
          }
        { totocleveldown }
          {
            \@@_thesis_fm_toc_set:nn {#1}
              { \int_compare:nNnTF { \int_use:c { l_@@_thesis_#1_toc_int } } < { 3 } { 2 } { 4 } }
          }
        { tocmultiple }
          {
            \int_compare:nNnT { \int_use:c { l_@@_thesis_#1_toc_int } } = { 0 }
              { \int_set:cn { l_@@_thesis_#1_toc_int } { 1 } }
            \int_compare:nNnT { \int_use:c { l_@@_thesis_#1_toc_int } } < { 3 }
              { \int_add:cn { l_@@_thesis_#1_toc_int } { 2 } }
            \bool_set_true:c { l_@@_thesis_#1_toc_locked_bool }
          }
      }
  }
\cs_generate_variant:Nn \@@_thesis_fm_apply:nn { nV }
%</prelim-declaration>
%    \end{macrocode}
%
%    \begin{macrocode}
%<*option&peri>
  abstract .code:n = { \@@_thesis_fm_set:nn { abstract } {#1} },
  abstract .default:n = true,
  declaration .code:n = { \@@_thesis_fm_set:nn { declaration } {#1} },
  declaration .default:n = true,
%</option&peri>
%    \end{macrocode}
%
% \subsubsection{Sprache des Logos}
%
% Die Sprache des Logos folgt per Voreinstellung der Hauptsprache des Dokuments.
% Dafür wird vor dem Verarbeiten der Optionen \doption{logo/language}\dcode{=auto} gesetzt.
% Wählen Nutzende explizit eine Sprache, so wird die automatische Erkennung wieder entfernt.
%    \begin{macrocode}
%<*optionloading&pre>
\str_clear:N \l_@@_logolang_str
\keys_set:nn { tudcd } { logo/language = auto }
%</optionloading&pre>
%<*optionloading&post>
\str_if_empty:NF \l_@@_logolang_str
  {
    \hook_gremove_code:nn { package/babel/after } { tudcd-language-detection-babel }
    \hook_gremove_code:nn { package/polyglossia/after } { tudcd-language-detection-polyglossia }
  }
\hook_gput_code:nnn { begindocument/before } { tudcd/thesis/logolanguage }
  {
    \str_if_empty:NTF \l_@@_logolang_str
      { \str_set:Nn \l_@@_logolang_str { de } }
      {
        \str_case:VnF \l_@@_logolang_str { { de } { } { en } { } }
          { \str_set:Nn \l_@@_logolang_str { en } }
      }
  }
%</optionloading&post>
%    \end{macrocode}
%
% \subsubsection{Voreinstellungen für \KOMAScript}
%
% Die Voreinstellungen der Option \doption{output} werden vor dem Laden von \dcode{scrbook} weitergereicht.
% Da \KOMAScript{} die globalen Optionen aus \dmacro{\documentclass} vor den weitergereichten Optionen verarbeitet,
% wird eine Voreinstellung nur dann weitergereicht, wenn keiner der zugehörigen Schlüssel explizit gesetzt worden ist.
%    \begin{macrocode}
%<*optionloading&post>
\cs_new_protected:Npn \@@_thesis_koma_default:nn #1#2
  {
    \bool_set_false:N \l_tmpa_bool
    \clist_map_inline:Nn \g_@@_thesis_user_koma_clist
      {
        \clist_map_inline:nn {#1}
          { \str_if_eq:nnT {##1} {####1} { \bool_set_true:N \l_tmpa_bool } }
      }
    \bool_if:NF \l_tmpa_bool { \PassOptionsToClass {#2} { scrbook } }
  }
\str_if_eq:VnTF \l_@@_thesis_output_str { print }
  {
    \@@_thesis_koma_default:nn { oneside, twoside } { twoside }
    \@@_thesis_koma_default:nn { open, openright, openany, openleft } { open=right }
    \@@_thesis_koma_default:nn { cleardoublepage } { cleardoublepage=empty }
    \@@_thesis_koma_default:nn { BCOR } { BCOR=10mm }
  }
  { \@@_thesis_koma_default:nn { oneside, twoside } { oneside } }
%</optionloading&post>
%    \end{macrocode}
%
% \subsection{Schriften}
%
% Der Fließtext bleibt in Computer Modern. Unter pdf\TeX{} wird dafür \dpkg{lmodern} mit der Kodierung T1 geladen,
% die Auszeichnungsschrift Noto Sans stellt das Paket \dpkg{noto-sans} bereit.
% Unter Lua\TeX{} und Xe\TeX{} ist Latin Modern bereits die Voreinstellung von \dpkg{fontspec},
% Noto Sans wird direkt über die Dateinamen eingebunden.
% Das Paket \dpkg{noto-sans} wird dort bewusst nicht genutzt, da es globale Schrifteigenschaften
% (\dmacro{\defaultfontfeatures}) setzt, die von Nutzenden geladene Schriften beeinflussen würden.
%
% Das Paket \dpkg{iftex} wird wie bei \dpkg{tudscr} immer geladen, da viele Vorlagen \dmacro{\iftutex} verwenden.
%    \begin{macrocode}
%<*body&peri>
\RequirePackage{iftex}
\sys_if_engine_opentype:TF
  {
    \RequirePackage{fontspec}
    \setsansfont { NotoSans }
      [
        Extension = .ttf ,
        UprightFont = *-Regular ,
        ItalicFont = *-Italic ,
        BoldFont = *-SemiBold ,
        BoldItalicFont = *-SemiBoldItalic
      ]
  }
  {
    \RequirePackage[T1]{fontenc}
    \RequirePackage{lmodern}
    \RequirePackage[semibold]{noto-sans}
  }
\hook_gput_code:nnn { begindocument/before } { tudcd/thesis/bodyfont }
  {
    \bool_if:NT \l_@@_thesis_bodyfont_noto_bool
      {
        \renewcommand*{\familydefault}{\sfdefault}
        \normalfont
      }
  }
%</body&peri>
%    \end{macrocode}
%
% Im Vorspann (\cs{frontmatter}) werden die Seiten mit großen römischen Ziffern nummeriert.
%    \begin{macrocode}
%<*body&peri>
\hook_gput_code:nnn { begindocument/before } { tudcd/thesis/romannumbers }
  {
    \cs_if_exist:NT \frontmatter
      {
        \hook_gput_code:nnn { cmd/frontmatter/after } { tudcd/thesis/romannumbers }
          { \pagenumbering { Roman } }
      }
  }
%</body&peri>
%    \end{macrocode}
%
% \subsection{Gestaltungselemente}
%
% Alle Gliederungsüberschriften und, da \dcode{scrbook} diese von \dcode{disposition} ableitet,
% auch die Kapiteleinträge im Inhaltsverzeichnis werden in Noto Sans und der Hervorhebungsfarbe gesetzt.
%    \begin{macrocode}
%<*body&peri>
\setkomafont{disposition}{\normalcolor\sffamily\bfseries\@@_select_highlight_color:}
%    \end{macrocode}
%
% Für die Titelseite werden die Elemente von \KOMAScript{} angepasst und zwei neue Elemente angelegt:
% \dcode{thesis} für die Art der Arbeit und den akademischen Grad sowie \dcode{titleinfo} für alle
% weiteren Angaben.
%    \begin{macrocode}
\setkomafont{title}{\usekomafont{disposition}\huge}
\setkomafont{subtitle}{\usekomafont{title}\Large\mdseries}
\setkomafont{subject}{\normalcolor\sffamily\Large}
\setkomafont{author}{\normalcolor\sffamily\Large}
\setkomafont{date}{\normalcolor\sffamily}
\setkomafont{publishers}{\normalcolor\sffamily}
\newkomafont{thesis}{\usekomafont{disposition}\Large}
\newkomafont{titleinfo}{\normalcolor\sffamily}
%    \end{macrocode}
%
% \subsection{Seitenstile}
%
% Es werden die Seitenstile von \dpkg{scrlayer-scrpage} verwendet.
% Kopf- und Fußzeile erhalten Noto Sans und die Hervorhebungsfarbe.
% Für Dokumente, welche für \dcode{tudscrreprt} geschrieben wurden, werden die dortigen Seitenstile
% als Aliase bereitgestellt.
%    \begin{macrocode}
\RequirePackage{scrlayer-scrpage}
\setkomafont{pageheadfoot}{\normalcolor\sffamily\@@_select_highlight_color:}
\automark[section]{chapter}
\pagestyle{scrheadings}
\DeclarePageStyleAlias{tudheadings}{scrheadings}
\DeclarePageStyleAlias{plain.tudheadings}{plain.scrheadings}
\DeclarePageStyleAlias{empty.tudheadings}{empty}
%    \end{macrocode}
%
% Wird \dpkg{hyperref} geladen, erhalten Verweise die Hervorhebungsfarbe, im Druck also Schwarz.
% Eigene Einstellungen mittels \dmacro{\hypersetup} haben Vorrang.
%    \begin{macrocode}
\hook_gput_code:nnn { package/hyperref/after } { tudcd/thesis }
  { \hypersetup { colorlinks , allcolors = highlightcolor } }
%</body&peri>
%    \end{macrocode}
%
% \subsection{Optionen nach dem Laden der Klasse}
%
% \begin{codedescribe}[macro,new=0.8.0]{\TUDoptions,\TUDoption}
% \begin{codesyntax}
% \tsmacro{\TUDoptions}{Schlüssel-Wert-Liste}
%
% \tsmacro{\TUDoption}{Schlüssel,Wert}
% \end{codesyntax}
% Zur Kompatibilität mit \dpkg{tudscr} existieren beide Befehle als Alternativen zu \dmacro{\TUDCDsetup}.
% Unbekannte Schlüssel werden nach dem Laden der Klasse an \dmacro{\KOMAoptions} weitergereicht.
% Kennt auch \KOMAScript{} den Schlüssel nicht (bspw.\@ die Layoutoptionen von \dpkg{tudscr}),
% wird er mit einer Warnung ignoriert.
% \end{codedescribe}
%
% Ob \KOMAScript{} einen Schlüssel kennt, wird anhand der Makros \dcode{KV@<Mitglied>@<Schlüssel>}
% aller Mitglieder der Familie \dcode{KOMA} geprüft, wie es auch \dpkg{scrbase} selbst tut.
%    \begin{macrocode}
%<*body&peri>
\NewDocumentCommand \TUDoptions { m } { \keys_set:nn { tudcd } {#1} }
\NewDocumentCommand \TUDoption { m m } { \keys_set:nn { tudcd } { #1 = {#2} } }
\msg_new:nnnn { tudcd } { thesis/unknown-option }
  { Unknown~option~'#1'~ignored. }
  {
    '#1'~is~neither~an~option~of~tudcdthesis~nor~of~KOMA-Script.~
    The~layout~options~of~tudscr~are~not~supported~by~tudcdthesis.
  }
\prg_new_protected_conditional:Npnn \@@_thesis_if_koma_key:n #1 { TF }
  {
    \bool_set_false:N \l_tmpa_bool
    \clist_map_inline:en { KOMA, \cs_if_exist_use:c { KOMA@key@familylist } }
      { \cs_if_exist:cT { KV@##1@#1 } { \bool_set_true:N \l_tmpa_bool } }
    \bool_if:NTF \l_tmpa_bool { \prg_return_true: } { \prg_return_false: }
  }
\cs_generate_variant:Nn \clist_map_inline:nn { en }
\keys_define:nn { tudcd }
  {
    unknown .code:n =
      {
        \exp_args:NV \@@_thesis_if_koma_key:nTF \l_keys_key_str
          {
            \tl_if_novalue:nTF {#1}
              { \exp_args:Ne \KOMAoptions { \l_keys_key_str } }
              { \exp_args:Ne \KOMAoptions { \l_keys_key_str = \exp_not:n {#1} } }
          }
          { \msg_warning:nnV { tudcd } { thesis/unknown-option } \l_keys_key_str }
      }
  }
