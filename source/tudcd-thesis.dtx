% \begin{codedescribe}[macro,new=0.8.0]{\thesis,\subject}
% \begin{codesyntax}
% \tsmacro{\thesis}{Art der Arbeit}
%
% \tsmacro{\subject}{Art der Arbeit}
% \end{codesyntax}
% Die Art der Arbeit kann als Freitext oder als eines der Schlüsselwörter
% \dcode{habil}, \dcode{diss} (\dcode{doctoral}, \dcode{phd}), \dcode{diploma}, \dcode{master},
% \dcode{bachelor}, \dcode{student}, \dcode{evidence}, \dcode{project}, \dcode{seminar},
% \dcode{term}, \dcode{research}, \dcode{log}, \dcode{report} und \dcode{internship}
% angegeben werden. Schlüsselwörter werden durch die sprachabhängige Bezeichnung ersetzt.
% Wird \dmacro{\subject} verwendet und ist noch keine Art der Arbeit gesetzt, so wird diese übernommen.
% \end{codedescribe}
%    \begin{macrocode}
\@@_thesis_new_field:nn { thesis } { }
\prop_const_from_keyval:Nn \c_@@_thesis_type_prop
  {
    habil = \habilitationname ,
    diss = \dissertationname ,
    doctoral = \dissertationname ,
    phd = \dissertationname ,
    diploma = \diplomathesisname ,
    master = \masterthesisname ,
    bachelor = \bachelorthesisname ,
    student = \studentthesisname ,
    evidence = \studentresearchname ,
    project = \projectpapername ,
    seminar = \seminarpapername ,
    term = \termpapername ,
    research = \researchname ,
    log = \logname ,
    report = \reportname ,
    internship = \internshipname
  }
\cs_new_protected:Npn \@@_thesis_type_set:Nn #1#2
  {
    \prop_get:NeNTF \c_@@_thesis_type_prop { \tl_trim_spaces:n {#2} } \l_@@_thesis_tmp_tl
      { \tl_gset_eq:NN #1 \l_@@_thesis_tmp_tl }
      { \tl_gset:Nn #1 {#2} }
  }
\NewDocumentCommand \thesis { m } { \@@_thesis_type_set:Nn \@thesis {#1} }
\RenewDocumentCommand \subject { m }
  {
    \@@_thesis_type_set:Nn \@subject {#1}
    \tl_if_empty:NT \@thesis { \tl_gset_eq:NN \@thesis \@subject }
  }
%    \end{macrocode}
